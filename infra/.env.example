# Zona horaria del API: fijada en docker-compose.yml (TZ=America/Guayaquil)
# Dominio público. En el VPS: lab.midominio.com (Caddy obtiene TLS solo).
# Para probar en local: SITE_ADDRESS=:80 y PUBLIC_URL=http://localhost (el compose solo publica 80/443)
SITE_ADDRESS=lab.midominio.com
PUBLIC_URL=https://lab.midominio.com
# PUBLIC_URL también se incrusta en la web al construirla: es la URL del QR de la orden
# imprimible. Si cambia el dominio, hay que reconstruir (docker compose up -d --build).

POSTGRES_USER=dentalware
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=dentalware

BETTER_AUTH_SECRET=genera-32-o-mas-caracteres-aleatorios-con-openssl-rand-base64-32

ADMIN_EMAIL=admin@lab.local
ADMIN_PASSWORD=cambia-esta-clave-tambien
ADMIN_NAME=Administrador

# Archivos de docker compose, relativos a infra/ (los respetan también los scripts de respaldo).
# En el VPS con nginx delante (docs/operacion/despliegue.md):
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml

# Respaldos (infra/backup/backup.sh y restore.sh, #111): todo queda en el servidor.
# Repositorio de restic: una carpeta local del VPS, cifrada con la contraseña de restic.
RESTIC_REPOSITORY=/var/backups/dentalware/restic
# Archivo con la contraseña de restic (chmod 600). Guárdala también en tu gestor de contraseñas:
# sin ella, el repositorio no se puede leer. Generarla: openssl rand -hex 32
RESTIC_PASSWORD_FILE=/etc/dentalware/restic-password
# Carpeta de trabajo: el dump del día (3 días, en db/), el bloqueo y las restauraciones.
BACKUP_LOCAL_DIR=/var/backups/dentalware
# Avisos opcionales (healthchecks.io u otro): recibe /start, el éxito y /fail. Vacía, no avisa
# a nadie y el resultado queda solo en el log (journald).
BACKUP_HEALTHCHECK_URL=
