{$SITE_ADDRESS}

encode zstd gzip

header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	Content-Security-Policy "frame-ancestors 'none'"
	-Server
}

# Docusaurus pone hash en sus assets: inmutables. Solo archivos que existen (404 si no).
handle /assets/* {
	header Cache-Control "public, max-age=31536000, immutable"
	root * /srv
	file_server
}

# Páginas, capturas y el índice del buscador: no-cache (se revalidan en cada visita).
# Con trailingSlash, cada página es <ruta>/index.html; una ruta que no existe da 404, nunca la
# portada.
handle {
	header Cache-Control "no-cache"
	root * /srv
	try_files {path} {path}/index.html
	file_server
}

# Una ruta que no existe responde 404 con la página «Página no encontrada» de Docusaurus
# (404.html); en handle_errors, file_server conserva el código del error.
handle_errors {
	@404 expression {http.error.status_code} == 404
	handle @404 {
		rewrite * /404.html
		file_server {
			root /srv
		}
	}
}
