# Configuración de los respaldos versionada en el repo, sin secretos (#111). Los secretos y las
# rutas de cada servidor van en infra/.env (ver infra/.env.example). Lo cargan los scripts de
# infra/backup/ con `source`: solo asignaciones VAR=valor, sin espacios.

# restic corre en contenedor (el VPS solo necesita Docker): versión fijada.
RESTIC_IMAGE=restic/restic:0.19.1
# Imagen auxiliar para leer y escribir el volumen de adjuntos.
HELPER_IMAGE=alpine:3.24

# Retención de los snapshots (`restic forget --prune`): 7 diarios, 4 semanales y 12 mensuales.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12

# El dump de Postgres del día queda además en $BACKUP_LOCAL_DIR/db durante estos días.
LOCAL_KEEP_DAYS=3
