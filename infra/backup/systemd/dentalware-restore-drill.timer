# El día 1 de cada mes a las 05:30 de Ecuador. Persistent: si el VPS estaba apagado a esa hora,
# corre al arrancar.
[Unit]
Description=Dentalware: simulacro de recuperación el día 1 de cada mes a las 05:30 (America/Guayaquil)

[Timer]
OnCalendar=*-*-01 05:30:00 America/Guayaquil
Persistent=true

[Install]
WantedBy=timers.target
