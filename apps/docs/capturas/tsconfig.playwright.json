{
  // Solo para el cargador de Playwright (`--tsconfig` en scripts/capturas.sh y en el script `sitio`
  // de package.json): no admite el `"baseUrl": null` de ../tsconfig.json (con el que TS 6 deja de
  // heredar el `baseUrl` de @docusaurus/tsconfig). Los tipos de estos archivos los sigue comprobando
  // ../tsconfig.json.
  "compilerOptions": { "strict": true }
}
