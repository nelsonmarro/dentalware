{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": null,
    "paths": { "@site/*": ["./*"] },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["@docusaurus/module-type-aliases", "@docusaurus/theme-classic"]
  },
  "include": [
    "src",
    "capturas",
    "scripts",
    "sitio",
    "docusaurus.config.ts",
    "sidebars.ts",
    "*.test.ts"
  ],
  "exclude": ["build", ".docusaurus"]
}
